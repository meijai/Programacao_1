@model List<Model.Product>

@{
    ViewData["Title"] = "Products List";
}
<a asp-controller="Product" asp-action="Create"> Novo Produto</a>

<div>
    <form method="get" asp-controller="Product"
          asp-action="Index">
        <input type="text" name="search"
               placeholder="Pesquisar" />
        <input type="submit" value="Buscar" />
    </form>
</div>

<table class="table table-striped table-responsive">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Preço</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>
                    <a asp-controller="Product"
                       asp-action="Update"
                       asp-route-id="@product.Id">Edit</a>
                    <a asp-controller="Product"
                       asp-action="Delete"
                       asp-route-id="@product.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>