@model List<Model.Customer>

@{
    ViewData["Title"] = "Customer List";
}
 <a asp-controller="Customer" asp-action="Create"> Novo Customer </a>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Id</td>
                <td>@customer.FirstName</td>
                <td>@customer.Email</td>
            </tr>
        }
    </tbody>
</table>