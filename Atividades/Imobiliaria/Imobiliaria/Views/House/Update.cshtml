@model Model.House

@{
    ViewData["Title"] = "Atualizar Imóvel";
}

<h2>Atualizar Imóvel</h2>

<form asp-action="Update" asp-route-id="@Model.Id" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Tittle"></label>
        <input asp-for="Tittle" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="BusinessType"></label>
        <select asp-for="BusinessType"
                asp-items="Html.GetEnumSelectList<Model.BusinessType>()"
                class="form-control">"
        </select>
    </div>
    <hr />

    <h4>Address</h4>
   
        <div class="border p-3 mb-2">

            <input type="hidden" asp-for="Address.Id" />

            <div class="form-group">
                <label asp-for="Address.Street"></label>
                <input asp-for="Address.Street" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Address.Number"></label>
                <input asp-for="Address.Number" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Address.City"></label>
                <input asp-for="Address.City" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Address.PostalCode"></label>
                <input asp-for="Address.PostalCode" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Address.Country"></label>
                <input asp-for="Address.Country" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Address.FederalState"></label>
                <input asp-for="Address.FederalState" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Address.AddressType"></label>
                <select asp-for="Address.AddressType"
                        asp-items="Html.GetEnumSelectList<Model.AddressType>()"
                        class="form-control">
                </select>
            </div>

        </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>