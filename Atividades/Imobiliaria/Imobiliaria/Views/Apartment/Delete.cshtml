@model Model.Apartment

<h2>
    Deseja realmente excluir a Residência?
</h2>

<div>
    Nome: @Model.Tittle
</div>

<form method="post" asp-controller="Apartment" asp-action="ConfirmDelete">
    <input type="hidden" asp-for="@Model.Id" />
    <input type="submit" value="Excluir" class="btn btn-danger" />
</form>