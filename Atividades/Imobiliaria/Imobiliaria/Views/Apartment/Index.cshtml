@model List<Model.Apartment>

@{
	ViewData["Title"] = "Apartment List";
}

<a asp-controller="Apartment" asp-action="Create">Novo Imóvel</a>

<div>
	<form method="get" asp-controller="Apartment"
		  asp-action="Index">
		<input type="text" name="search"
			   placeholder="Pesquisar" />
		<input type="submit" value="Buscar" />
	</form>
</div>
<table class="table table-striped table-responsive">
	<thead>
		<tr>
			<th>Id</th>
			<th>Título do Imóvel</th>
			<th>Descrição</th>
			<th>Preço</th>
			<th>Tipo de Negócio</th>
			<th>Ações</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var Apartment in Model)
		{
			<tr>
				<td>@Apartment.Id</td>
				<td>@Apartment.Tittle</td>
                <td>@Apartment.Description</td>
				<td>@Apartment.Price</td>
				<td>@Apartment.BusinessType</td>

				<td>
					<a asp-controller="Apartment"
					   asp-action="Update"
					   asp-route-id="@Apartment.Id">Edit</a> |
					<a asp-controller="Apartment"
					   asp-action="Delete"
					   asp-route-id="@Apartment.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>