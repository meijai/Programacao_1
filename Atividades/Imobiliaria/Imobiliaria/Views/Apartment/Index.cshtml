@model List<Model.Apartment>

@{
	ViewData["Title"] = "Apartment List";
}

<a asp-controller="Apartment" asp-action="Create">Novo Apartamento</a>

<div>
	<form method="get" asp-controller="Apartment" asp-action="Index">
		<input type="text" name="search" placeholder="Pesquisar" />
		<input type="submit" value="Buscar" />
	</form>
</div>

<table class="table table-striped table-responsive">
	<thead>
		<tr>
			<th>Id</th>
			<th>Título</th>
			<th>Número</th>
			<th>Andar</th>
			<th>Categoria</th>
			<th>Preço</th>
			<th>Cômodos</th>
			<th>Tipo</th>
			<th>Endereço</th>
			<th>Ações</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var apartment in Model)
		{
			<tr>
				<td>@apartment.Id</td>
				<td>@apartment.Tittle</td>
				<td>@apartment.ApartmentNumber do Apartamento</td>
				<td>@apartment.ApartmentFloor</td>
				<td>@apartment.Category</td>
				<td>@apartment.Price</td>
				<td>@apartment.Room</td>
				<td>@apartment.BusinessType</td>
				<td>@apartment.Address</td>

				<td>
					<a asp-controller="Apartment"
					   asp-action="Update"
					   asp-route-id="@apartment.Id">Edit</a> |
					<a asp-controller="Apartment"
					   asp-action="Delete"
					   asp-route-id="@apartment.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>